{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../dist/spec",
    // Restated because the inherited config declares typeRoots relative to its
    // own file, which lives inside node_modules/@firestitch/component-tools —
    // so the path it resolves to does not exist and no @types are ever found.
    "typeRoots": [
      "../node_modules/@types"
    ],
    "types": [
      "jasmine",
      "node"
    ]
  },
  "files": [
    "test.ts",
    "polyfills.ts"
  ],
  "include": [
    "**/*.spec.ts",
    "**/*.d.ts"
  ],
  "exclude": []
}
